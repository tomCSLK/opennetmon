# Texts of the browser scripts (static/*.js). No Fluent variables: the script fills in %1, %2.
js-decimal = .
js-date = MM/DD/YYYY
js-day = MM/DD
js-unit-day = day
js-unit-days = days
js-unit-hours = h
js-unit-minutes = min
js-oid-index = append the index (%1), e.g. %2.1
js-refresh-left = %1 s
js-refresh-paused = paused
js-oid-not-pollable = not a pollable number
js-chart-no-answer = no response
js-chart-toggle = Show or hide in the chart
js-samples-volume = %1 (volume)
js-samples-speed = %1 (speed)
js-samples-newest = newest %1 of %2 values
js-samples-one = 1 value
js-samples-many = %1 values
js-samples-date-time = Date time
js-samples-sum = Sum
js-samples-average = Average
js-samples-minimum = Minimum
js-samples-maximum = Maximum
js-samples-from-one = %1 (of 1 value)
js-samples-from-many = %1 (of %2 values)
js-samples-rows = Rows %1–%2 of %3
js-samples-page = Page %1 of %2
js-samples-first = First page
js-samples-previous = Previous page
js-samples-next = Next page
js-samples-last = Last page
js-events-count = %1 changes
js-events-since = %1 changes since %2
js-events-since-one = 1 change since %1
js-filter-count = %1 of %2
