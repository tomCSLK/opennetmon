# Caddy: automatic HTTPS with a public name, or `tls internal` for a private CA.
# Replace the host name; then `systemctl reload caddy`. Only needed instead of opennetmon's built-in HTTPS: set
# listen = "127.0.0.1:8080", remove the tls_ lines and set client_ip_header = "x-forwarded-for" in its config.
opennetmon.example.org {
	# tls internal
	reverse_proxy 127.0.0.1:8080
	header -Server
}
