#!/bin/sh
# postinst of the opennetmon .deb (dev/deb.sh). Does what deploy/install.sh does besides copying files:
# service user, owners of /etc/opennetmon, encryption key, HTTPS certificate, data and backup directories and the ping sysctl.
# cargo-deb inserts the systemd handling (enable, restart on upgrade) at the marker below.
set -e

USER_NAME=opennetmon
CONF_DIR=/etc/opennetmon
CONFIG=$CONF_DIR/config.toml
KEY=$CONF_DIR/secret.key
TLS_CERT=$CONF_DIR/tls-cert.pem
TLS_KEY=$CONF_DIR/tls-key.pem
STATE_DIR=/var/lib/opennetmon
BACKUP_DIR=/var/backups/opennetmon
SYSCTL=99-opennetmon-ping.conf

if [ "$1" = configure ]; then
  if ! getent passwd "$USER_NAME" >/dev/null; then
    useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$USER_NAME"
  fi
  # The service reads its config through the group. A stat override keeps these owners on every upgrade.
  if ! dpkg-statoverride --list "$CONF_DIR" >/dev/null; then
    dpkg-statoverride --update --add root "$USER_NAME" 0750 "$CONF_DIR"
  fi
  if ! dpkg-statoverride --list "$CONFIG" >/dev/null; then
    dpkg-statoverride --update --add root "$USER_NAME" 0640 "$CONFIG"
  fi
  if [ ! -e "$KEY" ]; then
    OPENNETMON_SECRET_KEY_FILE="$KEY" /usr/bin/opennetmon --config "$CONFIG" key generate >/dev/null
    chown "$USER_NAME:$USER_NAME" "$KEY"
    NEW_KEY=yes
  fi
  # Self-signed certificate for the host name and every address of the server (replaceable, see docs/betrieb.md).
  if [ ! -e "$TLS_CERT" ] && [ ! -e "$TLS_KEY" ]; then
    NAMES=""
    for name in $(hostname -f 2>/dev/null) $(hostname -I 2>/dev/null); do
      NAMES="$NAMES --name $name"
    done
    # shellcheck disable=SC2086 # one --name per word
    if /usr/bin/opennetmon --config "$CONFIG" tls generate --cert "$TLS_CERT" --key "$TLS_KEY" $NAMES; then
      chown "$USER_NAME:$USER_NAME" "$TLS_KEY"
    else
      echo "opennetmon: could not create the HTTPS certificate; create one with 'opennetmon tls generate' (docs/betrieb.md)."
    fi
  fi
  # systemd creates the state directory on the first start; `user add` runs before that.
  if [ ! -d "$STATE_DIR" ]; then
    install -d -m 0750 -o "$USER_NAME" -g "$USER_NAME" "$STATE_DIR"
  fi
  if [ ! -d "$BACKUP_DIR" ]; then
    install -d -m 0700 -o "$USER_NAME" -g "$USER_NAME" "$BACKUP_DIR"
  fi
  # Unprivileged ICMP sockets for ping sensors, unless an admin overrides the file in /etc/sysctl.d/.
  if [ ! -e "/etc/sysctl.d/$SYSCTL" ]; then
    sysctl -q -p "/usr/lib/sysctl.d/$SYSCTL" >/dev/null 2>&1 || true
  fi
fi

#DEBHELPER#

if [ "$1" = configure ]; then
  if [ -d /run/systemd/system ] && systemctl --quiet is-enabled opennetmon-backup.timer 2>/dev/null; then
    deb-systemd-invoke start opennetmon-backup.timer >/dev/null || true
  fi
  # Leftovers of deploy/install.sh: its units in /etc override the packaged ones.
  if [ -e /etc/systemd/system/opennetmon.service ] || [ -e /usr/local/bin/opennetmon ]; then
    echo "opennetmon: files of deploy/install.sh are still present; its units in /etc/systemd/system override this package."
    echo "  Remove them (configuration, key and data stay):"
    echo "    sudo systemctl disable --now opennetmon opennetmon-backup.timer"
    echo "    sudo rm /etc/systemd/system/opennetmon.service /etc/systemd/system/opennetmon-backup.* /usr/local/bin/opennetmon*"
    echo "    sudo rm -r /usr/local/sbin/opennetmon-backup /usr/local/share/doc/opennetmon"
    echo "    sudo systemctl daemon-reload && sudo systemctl enable --now opennetmon opennetmon-backup.timer"
  fi
  if [ "${NEW_KEY:-}" = yes ]; then
    echo "opennetmon: generated $KEY - back it up separately from the database."
  fi
  if [ -z "$2" ] && [ ! -e "$STATE_DIR/opennetmon.db" ]; then
    echo "opennetmon: next steps:"
    echo "  sudo -u $USER_NAME opennetmon --config $CONFIG user add admin --role admin"
    echo "  sudo systemctl start opennetmon"
    echo "  then open https://<address of this server>:8443 (allow port 8443 in the firewall if one is active)"
  fi
fi

exit 0
