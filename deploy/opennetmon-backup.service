[Unit]
Description=opennetmon database backup
Documentation=https://github.com/tomCSLK/opennetmon

[Service]
Type=oneshot
User=opennetmon
Group=opennetmon
ExecStart=/usr/local/sbin/opennetmon-backup
UMask=0077

# Reading a WAL database needs write access to its -wal/-shm files, hence /var/lib/opennetmon.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/opennetmon /var/backups/opennetmon
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Blocking setuid lets systemd apply the filters before switching to the user; otherwise it needs to keep CAP_SYS_ADMIN,
# which containers (LXC, rootless Podman) refuse ("Failed to keep CAP_SYS_ADMIN").
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
