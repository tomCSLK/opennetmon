[Unit]
Description=netmon - agentless SNMP network monitor
Documentation=https://github.com/tomCSLK/netmon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netmon
Group=netmon
ExecStart=/usr/local/bin/netmon --config /etc/netmon/config.toml serve
Restart=on-failure
RestartSec=5
# On shutdown the poller stops first, then pending alert mails are sent (up to 20 s).
TimeoutStopSec=40

# /var/lib/netmon (database), created and owned by the service user, mode 0750.
StateDirectory=netmon
StateDirectoryMode=0750
UMask=0077

# Hardening: the service needs the network (SNMP, ICMP, SMTP, its own listener) and its state directory, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
# Ping uses unprivileged ICMP sockets (sysctl net.ipv4.ping_group_range, see deploy/99-netmon-ping.conf).
# Without that sysctl, grant raw sockets to this service instead by replacing the two lines above with:
#   CapabilityBoundingSet=CAP_NET_RAW
#   AmbientCapabilities=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
